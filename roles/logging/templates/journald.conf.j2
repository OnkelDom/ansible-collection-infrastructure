# Ansible managed: degitag.infrastructure.logging
[Journal]
Storage={{ logging_journald_storage }}
SystemMaxUse={{ logging_journald_system_max_use }}
SystemKeepFree={{ logging_journald_system_keep_free }}
RuntimeMaxUse={{ logging_journald_runtime_max_use }}
{% if logging_journald_runtime_keep_free | length %}
RuntimeKeepFree={{ logging_journald_runtime_keep_free }}
{% endif %}
{% if logging_journald_system_max_file_size | length %}
SystemMaxFileSize={{ logging_journald_system_max_file_size }}
{% endif %}
{% if logging_journald_runtime_max_file_size | length %}
RuntimeMaxFileSize={{ logging_journald_runtime_max_file_size }}
{% endif %}
{% if logging_journald_max_retention_sec | length %}
MaxRetentionSec={{ logging_journald_max_retention_sec }}
{% endif %}
